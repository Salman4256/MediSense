<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local healthcare database and auth session prefs from cloud backup -->
        <exclude domain="database" path="medisense_db" />
        <exclude domain="database" path="medisense_db-wal" />
        <exclude domain="database" path="medisense_db-shm" />
        <exclude domain="sharedpref" path="medisense_auth_session_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="medisense_auth_session_prefs.xml" />
    </device-transfer>
</data-extraction-rules>