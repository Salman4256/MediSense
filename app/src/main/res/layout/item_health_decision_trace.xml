<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_trace_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Type Badge & Confidence/Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_trace_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="DISEASE PREDICTION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_trace_confidence_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_supports"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="92% Confidence"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Engine Component & Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_trace_engine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LiteRT Classifier + SHAP XAI"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_trace_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sep 7, 2026 • 12:45 PM"
                android:textSize="11sp"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>

        <!-- Main Outcome / Decision Text -->
        <TextView
            android:id="@+id/tv_trace_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evaluated top predicted condition with XAI feature contributions."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <!-- Input Factors Preview -->
        <TextView
            android:id="@+id/tv_trace_factors_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Top factors: Fever (0.85), Cough (0.64), Fatigue (0.42)"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="10dp" />

        <!-- Footer Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Non-diagnostic safety limits applied"
                android:textSize="11sp"
                android:textColor="?attr/colorOutline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_trace"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@drawable/ic_share"
                app:iconTint="?attr/colorPrimary"
                android:contentDescription="Export Trace" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_inspect_trace"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Inspect Trace"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
