<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Step Index Number Circle -->
    <TextView
        android:id="@+id/tv_step_index"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_badge_info"
        android:gravity="center"
        android:text="1"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="?attr/colorPrimary" />

    <!-- Step Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_step_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Ingestion &amp; Feature Vector Assembly"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_step_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ingested 4 reported symptoms and mapped to multi-hot binary input vector."
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_step_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/colorSurfaceContainerHigh"
            android:padding="6dp"
            android:text="Output: feature_vector[132], active_features=4"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:fontFamily="monospace"
            android:visibility="visible" />
    </LinearLayout>

</LinearLayout>
