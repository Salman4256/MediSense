<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_factor_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fever / High Body Temp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_factor_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_supports"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="+ Supports"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_factor_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.85"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_factor_weight"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceContainerHigh"
        android:progress="85" />

    <TextView
        android:id="@+id/tv_factor_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Primary driver elevating decision probability above baseline."
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
