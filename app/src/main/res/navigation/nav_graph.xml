<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.medisense.app.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_firstLaunchFragment"
            app:destination="@id/firstLaunchFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- First-Launch Onboarding & Permission Explanation -->
    <fragment
        android:id="@+id/firstLaunchFragment"
        android:name="com.medisense.app.ui.onboarding.FirstLaunchFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_first_launch">
        <action
            android:id="@+id/action_firstLaunchFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_firstLaunchFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.medisense.app.ui.auth.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.medisense.app.ui.auth.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.medisense.app.ui.auth.ui.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password" />
        
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.medisense.app.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_healthRecordFragment"
            app:destination="@id/healthRecordFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_diseasePredictionFragment"
            app:destination="@id/diseasePredictionFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_dashboardFragment_to_aiAssistantFragment"
            app:destination="@id/healthAssistantFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_medicationListFragment"
            app:destination="@id/medicationListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_appointmentFragment"
            app:destination="@id/appointmentFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_predictionHistoryFragment"
            app:destination="@id/predictionHistoryFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_longitudinalHealthFragment"
            app:destination="@id/longitudinalHealthFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_rchrFragment"
            app:destination="@id/rchrFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_contextualRiskFragment"
            app:destination="@id/contextualRiskFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_personalizedGuidanceFragment"
            app:destination="@id/personalizedGuidanceFragment" />
    </fragment>

    <!-- Module 12: Adaptive Personalized Guidance & Recommendation Engine -->
    <fragment
        android:id="@+id/personalizedGuidanceFragment"
        android:name="com.medisense.app.ui.guidance.ui.PersonalizedGuidanceFragment"
        android:label="Personalized Guidance"
        tools:layout="@layout/fragment_personalized_guidance">
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_medicationListFragment"
            app:destination="@id/medicationListFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_appointmentFragment"
            app:destination="@id/appointmentFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_predictionHistoryFragment"
            app:destination="@id/predictionHistoryFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_longitudinalHealthFragment"
            app:destination="@id/longitudinalHealthFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_rchrFragment"
            app:destination="@id/rchrFragment" />
        <action
            android:id="@+id/action_personalizedGuidanceFragment_to_contextualRiskFragment"
            app:destination="@id/contextualRiskFragment" />
    </fragment>

    <!-- Module 9B: Longitudinal Health Trends & Temporal Patterns -->
    <fragment
        android:id="@+id/longitudinalHealthFragment"
        android:name="com.medisense.app.ui.analytics.ui.LongitudinalHealthFragment"
        android:label="Health Trends &amp; Analytics"
        tools:layout="@layout/fragment_longitudinal_health" />

    <!-- Module 10: Reversible Composite Health Representation (RCHR) -->
    <fragment
        android:id="@+id/rchrFragment"
        android:name="com.medisense.app.ui.rchr.ui.RchrFragment"
        android:label="Composite Health Representation (RCHR)"
        tools:layout="@layout/fragment_rchr" />

    <!-- Module 11: Context-Aware Health Risk Engine -->
    <fragment
        android:id="@+id/contextualRiskFragment"
        android:name="com.medisense.app.ui.risk.ui.ContextualRiskFragment"
        android:label="Health Context &amp; Risk Priority"
        tools:layout="@layout/fragment_contextual_risk" />

    <fragment
        android:id="@+id/healthRecordFragment"
        android:name="com.medisense.app.ui.healthrecord.ui.HealthRecordFragment"
        android:label="Health Record"
        tools:layout="@layout/fragment_health_record" />

    <fragment
        android:id="@+id/diseasePredictionFragment"
        android:name="com.medisense.app.ui.prediction.ui.DiseasePredictionFragment"
        android:label="Disease Prediction"
        tools:layout="@layout/fragment_disease_prediction">
        <action
            android:id="@+id/action_diseasePredictionFragment_to_predictionResultFragment"
            app:destination="@id/predictionResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/predictionResultFragment"
        android:name="com.medisense.app.ui.prediction.ui.PredictionResultFragment"
        android:label="Prediction Results"
        tools:layout="@layout/fragment_prediction_result">
        <action
            android:id="@+id/action_predictionResultFragment_to_predictionHistoryFragment"
            app:destination="@id/predictionHistoryFragment" />
    </fragment>

    <!-- Module 8: Prediction History -->
    <fragment
        android:id="@+id/predictionHistoryFragment"
        android:name="com.medisense.app.ui.predictionhistory.ui.PredictionHistoryFragment"
        android:label="Prediction History"
        tools:layout="@layout/fragment_prediction_history">
        <action
            android:id="@+id/action_predictionHistoryFragment_to_predictionHistoryDetailFragment"
            app:destination="@id/predictionHistoryDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/predictionHistoryDetailFragment"
        android:name="com.medisense.app.ui.predictionhistory.ui.PredictionHistoryDetailFragment"
        android:label="Prediction Detail"
        tools:layout="@layout/fragment_prediction_history_detail" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.medisense.app.ui.profile.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/healthAssistantFragment"
        android:name="com.medisense.app.ui.assistant.ui.HealthAssistantFragment"
        android:label="AI Health Assistant"
        tools:layout="@layout/fragment_health_assistant">
        <action
            android:id="@+id/action_healthAssistantFragment_to_chatHistoryFragment"
            app:destination="@id/chatHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatHistoryFragment"
        android:name="com.medisense.app.ui.assistant.ui.ChatHistoryFragment"
        android:label="Chat History"
        tools:layout="@layout/fragment_chat_history">
        <action
            android:id="@+id/action_chatHistoryFragment_to_healthAssistantFragment"
            app:destination="@id/healthAssistantFragment" />
    </fragment>

    <fragment
        android:id="@+id/medicationListFragment"
        android:name="com.medisense.app.ui.medication.ui.MedicationFragment"
        android:label="Medication Reminders"
        tools:layout="@layout/fragment_medication">
        <action
            android:id="@+id/action_medicationListFragment_to_addEditMedicationFragment"
            app:destination="@id/addEditMedicationFragment" />
        <action
            android:id="@+id/action_medicationListFragment_to_medicationHistoryFragment"
            app:destination="@id/medicationHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditMedicationFragment"
        android:name="com.medisense.app.ui.medication.ui.AddMedicationFragment"
        android:label="Add / Edit Medication"
        tools:layout="@layout/fragment_add_medication" />

    <fragment
        android:id="@+id/medicationHistoryFragment"
        android:name="com.medisense.app.ui.medication.ui.MedicationHistoryFragment"
        android:label="Medication History"
        tools:layout="@layout/fragment_medication_history" />

    <!-- Module 7: Appointments -->
    <fragment
        android:id="@+id/appointmentFragment"
        android:name="com.medisense.app.ui.appointment.ui.AppointmentFragment"
        android:label="Appointments"
        tools:layout="@layout/fragment_appointment">
        <action
            android:id="@+id/action_appointmentFragment_to_addAppointmentFragment"
            app:destination="@id/addAppointmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/addAppointmentFragment"
        android:name="com.medisense.app.ui.appointment.ui.AddAppointmentFragment"
        android:label="Schedule Appointment"
        tools:layout="@layout/fragment_add_appointment" />

</navigation>